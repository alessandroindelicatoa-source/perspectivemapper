# Optional. If this section is absent, the app opens without a login screen.
# Copy this file to .streamlit/secrets.toml (never commit it) or paste the
# section into the Secrets box of Streamlit Community Cloud.
#
# Passwords can be stored in plain text or, preferably, as SHA-256 hashes
# prefixed with "sha256:". Generate a hash with:
#   python -c "import hashlib,getpass; print('sha256:'+hashlib.sha256(getpass.getpass().encode()).hexdigest())"
[passwords]
admin = "sha256:replace-with-your-hash"
